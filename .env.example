# Neon
DATABASE_URL=postgresql://...

# Clerk (auth + billing; enable Organizations and B2B plans in the dashboard)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Inngest
INNGEST_EVENT_KEY=...
INNGEST_SIGNING_KEY=...

# AssemblyAI (audio/video ingestion)
ASSEMBLYAI_API_KEY=...

# Resend
RESEND_API_KEY=re_...

# Blob storage (Vercel Blob or S3-compatible)
BLOB_BASE_URL=https://...
BLOB_READ_WRITE_TOKEN=...

# Sentry (error tracking) — blank disables it (no-op). AUTH_TOKEN/ORG/PROJECT
# enable source-map upload during deploy builds.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# YouTube transcript API (Supadata) — optional. Without it, YouTube works only
# when the video has captions AND YouTube does not block the request. With it,
# YouTube transcription is reliable, including uncaptioned videos.
SUPADATA_API_KEY=

# DataForSEO API credentials (app.dataforseo.com → API Access). Powers measured keyword research;
# without them intelligence runs fall back to web-search keyword research.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Mavrix admin org — which Clerk org sees the Blog Schedule / Resources library
# (Mavrix's own publishing surface, not a per-tenant feature). Comma-separated
# Clerk org ids and/or org names. If blank, defaults to the org named "Mavrix".
MAVRIX_ADMIN_ORG=org_xxxxxxxxxxxxxxxxxxxxxxxx
