# Neon
DATABASE_URL=postgresql://...

# Clerk (auth + billing; enable Organizations and B2B plans in the dashboard)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Inngest
INNGEST_EVENT_KEY=...
INNGEST_SIGNING_KEY=...

# AssemblyAI (audio/video ingestion)
ASSEMBLYAI_API_KEY=...

# Resend
RESEND_API_KEY=re_...

# Blob storage (Vercel Blob or S3-compatible)
BLOB_BASE_URL=https://...
BLOB_READ_WRITE_TOKEN=...

# Sentry (error tracking) — blank disables it (no-op). AUTH_TOKEN/ORG/PROJECT
# enable source-map upload during deploy builds.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
